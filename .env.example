# Optional: required only for AI generation and document embeddings.
GEMINI_API_KEY=your_google_ai_studio_key
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional: the backend works with its embedded H2 database by default.
# To use MySQL instead, uncomment SPRING_PROFILES_ACTIVE and configure these values.
# SPRING_PROFILES_ACTIVE=mysql
# DATABASE_URL=jdbc:mysql://localhost:3306/ai_work_copilot
# DATABASE_USERNAME=root
# DATABASE_PASSWORD=

# Optional: enable RAG document retrieval by running Chroma locally.
# CHROMA_URL=http://localhost:8000
